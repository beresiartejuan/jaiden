{
  "name": "jaiden",
  "version": "0.2.0",
  "description": "Tu compañero de terminal open source: CLI local con Ollama, modelos chicos (1.5B–3B), memoria simple y modos fast/smart",
  "type": "module",
  "license": "MIT",
  "author": "Juan Beresiarte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beresiartejuan/jaiden.git"
  },
  "homepage": "https://github.com/beresiartejuan/jaiden#readme",
  "bugs": "https://github.com/beresiartejuan/jaiden/issues",
  "keywords": [
    "ollama",
    "cli",
    "llm",
    "local",
    "assistant",
    "companion"
  ],
  "bin": {
    "jaiden": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "trustPolicy": "no-downgrade",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
