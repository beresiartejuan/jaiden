{
  "name": "jaiden",
  "version": "0.1.0",
  "description": "Mini asistente de código de código abierto que corre con Ollama local",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jaiden": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "trustPolicy": "no-downgrade",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
